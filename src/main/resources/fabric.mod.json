{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Port of Immersive Portals (see-through portals, seamless teleportation) to Minecraft 1.21.11, with Iris compatibility as a hard requirement. Work in progress.",
  "authors": [
    "Claude (port)",
    "qouteall and the Immersive Portals contributors (original mod)"
  ],
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.claudeportals.ClaudePortalsMain",
      "qouteall.dimlib.DimLibEntry"
    ],
    "client": [
      "dev.claudeportals.client.ClaudePortalsClient",
      "qouteall.dimlib.DimLibEntryClient"
    ],
    "modmenu": ["dev.claudeportals.client.ClaudePortalsModMenu"]
  },
  "mixins": [
    "dimlib.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*"
  },
  "suggests": {
    "sodium": "*",
    "iris": "*",
    "distanthorizons": "*"
  }
}
